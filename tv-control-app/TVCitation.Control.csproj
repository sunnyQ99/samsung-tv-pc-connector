<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TVCITATION.Control</AssemblyName>
    <RootNamespace>TVCitation.Control</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Description>Live picture and remote control for a Samsung TV</Description>
    <Company>TVCITATION</Company>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <Compile Remove="checks\**\*.cs" />
    <InternalsVisibleTo Include="TVCITATION.Control.Checks" />
  </ItemGroup>
</Project>
