+def _list_dotnet_runtimes(client: SdbClient) -> str:
+    command = "/usr/bin/dotnet --list-runtimes"
+    output = client.capture(command, timeout=15.0).output
+    # Samsung's launcher can reject the host CLI option despite an installed CLR.
+    # Require its exact diagnostic and a completed command, not a generic failure.
+    if re.search(r"(?m)^Unknown option --list-runtimes\.\r?$", output) and re.search(
+        r"\n\[exit:\d+\]\s*\Z", output
+    ):
+        return _capture(
+            client,
+            f'for runtime in "{DOTNET_RUNTIME_ROOT}"/*; do '
+            'if [ -d "$runtime" ] '
+            '&& [ -f "$runtime/System.Private.CoreLib.dll" ] '
+            '&& [ -f "$runtime/libcoreclr.so" ]; then '
+            "printf 'Microsoft.NETCore.App %s [%s]\\n' "
+            f'"${{runtime##*/}}" "{DOTNET_RUNTIME_ROOT}"; fi; done',
+        )
+    if "[exit:0]" not in output:
+        raise ArchiveRootError(f"SDK command failed: {command}: {output.strip()}")
+    return output.split("\n[exit:0]", 1)[0].strip()
+
