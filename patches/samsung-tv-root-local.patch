diff --git a/tests/test_archive_root_runtime.py b/tests/test_archive_root_runtime.py
new file mode 100644
index 0000000..6c62934
--- /dev/null
+++ b/tests/test_archive_root_runtime.py
@@ -0,0 +1,164 @@
+"""Offline checks for Samsung launchers without --list-runtimes support."""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from samsung_tv_root import archive_root
+from samsung_tv_root.sdb import CaptureResult, SdbError
+
+
+class RuntimeClient:
+    def __init__(self, runtime_output, fallback_output="", tar_output="--to-command"):
+        self.runtime_output = runtime_output
+        self.fallback_output = fallback_output
+        self.tar_output = tar_output
+        self.commands = []
+
+    def connect(self):
+        pass
+
+    def require_device(self):
+        pass
+
+    def require_shell_injection(self):
+        pass
+
+    def capture(self, command, timeout=15):
+        self.commands.append(command)
+        if command.startswith("getcap"):
+            output = (
+                "/usr/bin/dotnet cap_setgid,cap_sys_admin=ei\n"
+                "/usr/sbin/sdbd-tarlauncher cap_setgid,cap_setuid=eip"
+            )
+        elif command == "/usr/bin/dotnet --list-runtimes":
+            if isinstance(self.runtime_output, Exception):
+                raise self.runtime_output
+            return CaptureResult(self.runtime_output, 0.0)
+        elif command.startswith("for runtime in "):
+            if callable(self.fallback_output):
+                return self.fallback_output(command)
+            output = self.fallback_output
+        elif "tar --help" in command:
+            output = self.tar_output
+        elif command == archive_root.SYSTEM_HASH_COMMAND:
+            output = "hash-passwd /etc/passwd\nhash-key /usr/share/sdbd/public.pem"
+        else:
+            raise AssertionError(f"unexpected command: {command}")
+        return CaptureResult(output + "\n[exit:0]\n", 0.0)
+
+
+def test_prepared_passwd_uses_unix_line_ending(tmp_path, monkeypatch):
+    monkeypatch.setattr(archive_root, "_openssl", lambda *arguments: None)
+    archive_root._prepare_artifacts(
+        tmp_path, "6.0", "archive-root-test", "192.0.2.77", 12345, b"x" * 32
+    )
+    assert (tmp_path / "passwd").read_bytes() == (
+        b"owner:x:0:0:owner:/home/owner:/bin/sh\n"
+    )
+
+
+@pytest.mark.parametrize(
+    ("version", "expected"), (("6.0.9", "6.0"), ("3.1.3", "3.1"), ("8.0.1", "6.0"))
+)
+@pytest.mark.parametrize("exit_code", (0, 1))
+def test_samsung_launcher_fallback_selects_supported_runtime(
+    version, expected, exit_code
+):
+    client = RuntimeClient(
+        f"Unknown option --list-runtimes.\n[exit:{exit_code}]\n",
+        f"Microsoft.NETCore.App {version} [{archive_root.DOTNET_RUNTIME_ROOT}]",
+    )
+    assessment = archive_root._check_target(client)
+    assert assessment.runtime == expected
+    assert any("tar --help" in command for command in client.commands)
+    assert client.commands[-1] == archive_root.SYSTEM_HASH_COMMAND
+
+
+@pytest.mark.parametrize(
+    "output",
+    (
+        "Permission denied\n[exit:126]\n",
+        "Unknown option --info.\n[exit:1]\n",
+        "Unknown option --list-runtimes.\n",  # Incomplete capture is not evidence.
+        "Segmentation fault\n[exit:139]\n",
+    ),
+)
+def test_ordinary_failure_does_not_trigger_fallback(output):
+    client = RuntimeClient(output)
+    with pytest.raises(archive_root.ArchiveRootError, match="SDK command failed"):
+        archive_root._check_target(client)
+    assert not any(command.startswith("for runtime in ") for command in client.commands)
+
+
+def test_capture_transport_error_does_not_trigger_fallback():
+    client = RuntimeClient(SdbError("capture timed out"))
+    with pytest.raises(SdbError, match="timed out"):
+        archive_root._check_target(client)
+    assert not any(command.startswith("for runtime in ") for command in client.commands)
+
+
+@pytest.mark.parametrize("version", (None, "5.0.17", "6.0.9-invalid"))
+def test_fallback_rejects_absent_or_unsupported_runtime(version):
+    output = "" if version is None else f"Microsoft.NETCore.App {version} [/ignored]"
+    client = RuntimeClient("Unknown option --list-runtimes.\n[exit:1]\n", output)
+    with pytest.raises(archive_root.ArchiveRootError, match="no supported"):
+        archive_root._check_target(client)
+
+
+def test_fallback_keeps_tar_requirement():
+    client = RuntimeClient(
+        "Unknown option --list-runtimes.\n[exit:1]\n",
+        f"Microsoft.NETCore.App 6.0.9 [{archive_root.DOTNET_RUNTIME_ROOT}]",
+        tar_output="",
+    )
+    with pytest.raises(archive_root.ArchiveRootError, match="tar does not support"):
+        archive_root._check_target(client)
+
+
+@pytest.mark.parametrize(
+    "files",
+    (
+        (),
+        ("System.Private.CoreLib.dll",),
+        ("libcoreclr.so",),
+        ("System.Private.CoreLib.dll", "libcoreclr.so"),
+    ),
+)
+def test_fallback_enumeration_requires_both_runtime_files(tmp_path, monkeypatch, files):
+    shell = shutil.which("sh")
+    if shell is None and os.name == "nt":
+        git_bash = (
+            Path(os.environ.get("ProgramFiles", "C:/Program Files"))
+            / "Git/bin/bash.exe"
+        )
+        shell = str(git_bash) if git_bash.is_file() else None
+    if shell is None:
+        pytest.skip("POSIX shell unavailable for offline enumeration check")
+    runtime_root = tmp_path / "Microsoft.NETCore.App"
+    runtime = runtime_root / "6.0.9"
+    runtime.mkdir(parents=True)
+    for name in files:
+        (runtime / name).touch()
+    monkeypatch.setattr(archive_root, "DOTNET_RUNTIME_ROOT", runtime_root.as_posix())
+
+    def enumerate_locally(command):
+        result = subprocess.run(
+            (shell, "-c", command), capture_output=True, text=True, check=False
+        )
+        assert result.returncode == 0, result.stderr
+        return CaptureResult(result.stdout + "\n[exit:0]\n", 0.0)
+
+    client = RuntimeClient(
+        "Unknown option --list-runtimes.\n[exit:1]\n", enumerate_locally
+    )
+    if len(files) == 2:
+        assert archive_root._check_target(client).runtime == "6.0"
+    else:
+        with pytest.raises(archive_root.ArchiveRootError, match="no supported"):
+            archive_root._check_target(client)
